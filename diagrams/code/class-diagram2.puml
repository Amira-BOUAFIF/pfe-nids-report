@startuml class2
skinparam dpi 300
hide circle


' Core Classes 

class User {
    -id : Long
    - username: String
    - email: String
    - passwordHash: String
    - role: Enum
    - createdAt: DateTime
    --

}

class Alert {
    -id : Long
    - severity: Enum
    - raisedAt: DateTime
    - acknowledgedAt: DateTime
    - resolvedAt: DateTime
    - analystNotes: String
    - status: Enum
    --

}

class Attack {
    -id : Long
    - name: String
    - category: Enum
    - defaultSeverity: Enum
    - description: String
    --

}

class NetworkFlow {
    -id : Long
    - timestamp: DateTime
    - sourceIP: String
    - destinationIP: String
    - sourcePort: int
    - destinationPort: int
    - protocol: String
    - fwdPackets: int
    - bwdPackets: int
    - fwdBytes: Long
    - bwdBytes: Long
    - flowDuration: float
    - flowBytesPerSec: float
    - flowPacketsPerSec: float
    - predictionLabel: String
    - confidence: float  
    --

}

class NetworkFlowDiagnostics{
    - id : Long
    - avgPacketSize: float
    - fwdPacketLengthMean: float
    - bwdPacketLengthMean: float
    - minPacketLength: int
    - synCount: int
    - ackCount: int
    - finCount: int
    - pshCount: int
    - urgCount: int
    - downUpRatio: float
    - initWinBytesForward: int
    - initWinBytesBackward: int
    --

}

class AuditLog {
    - id : Long
    - userId: Long
    - timestamp: DateTime
    - action: String
    - details: String
    --

}

class Report {
    - id : Long
    - title: String
    - generatedAt: DateTime
    - periodStart: DateTime
    - periodEnd: DateTime 
    - format: Enum
    - filePath: String
    --

}

class Configuration {
    - id : Long
    - key: String
    - value: String
    - updatedAt: DateTime
    --

}

' ─── Class Relationships ──────────────────────────────

' A flow triggers at most one alert
NetworkFlow "1"   --  "0..1"  Alert      : triggers 

' A flow has diagnostic information
NetworkFlow "1"   --  "0..1"  NetworkFlowDiagnostics : has

' An alert is classified as one attack type
Alert          "0..*"   --  "1"     Attack : classified as 

' Admin manages alert status
User           "1"   --  "0..*"  Alert      : manages 

' User actions recorded in audit log
User           "1"   --  "0..*"  AuditLog   : generates

' Report aggregates alerts over a period
Report         "1"   --  "0..*"  Alert      : contains 

AuditLog -[hidden]- Configuration
@enduml