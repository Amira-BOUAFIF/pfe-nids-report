@startuml use-Case
skinparam dpi 300
left to right direction
skinparam packageStyle rectangle


' ─── Left Actors ──────────────────────────────────────
actor "User" as User
actor "Network/Security\nAdministrator" as Admin
actor "IT Manager"                       as ITMgr


' ─── System Boundary ──────────────────────────────────
rectangle "NIDS Web Application" {

    usecase "Trigger Network Analysis" as UC_NET
    usecase "Analyze Network Flow" as UC_NET_FLOW
    usecase "send Alert" as UC_ALERT

    usecase "Authenticate" as UC_AUTH


    usecase "View Dashboard"          as UC_VIEW_DASH
    usecase "View Statistics Summary" as UC_VIEW_STATS


    usecase "View Alerts List"  as UC_ALERT_LIST
    usecase "View Alert Detail" as UC_ALERT_DETAIL
    usecase "Search Alerts" as UC_ALERT_SEARCH
    usecase  "Manage Alert Status" as UC_ALERT_STATUS

    usecase "View Reports"  as UC_VIEW_REPORTS
    usecase "Export Report" as UC_EXPORT_REPORT
    usecase "Generate Report" as UC_GEN_REPORT
    usecase "View Report" as UC_VIEW_REPORT

    hide UC_VIEW_REPORT

}

' ─── Right Actor ──────────────────────────────────────
rectangle "     <<actor>>\n\nEmail Service\n" as DE

UC_AUTH       -[hidden]left- UC_VIEW_DASH
UC_VIEW_DASH  -[hidden]left- UC_VIEW_STATS
UC_VIEW_STATS -[hidden]left- UC_NET


UC_ALERT_LIST -[hidden]left- UC_VIEW_REPORTS

' ─── Admin + IT Manager associations ───────────────────────────────
User -- UC_AUTH
User -- UC_VIEW_DASH
User -- UC_VIEW_STATS

' ─── Admin associations ───────────────────────────────
Admin -- UC_NET
Admin -- UC_ALERT_LIST



' ─── IT Manager associations ──────────────────────────
ITMgr -- UC_VIEW_REPORTS




' ─── Email Service associations ───────────────────
'UC_EXPORT_REPORT -[hidden]- DE


UC_NET .down.> UC_NET_FLOW : <<include>>
UC_ALERT .left.> UC_NET_FLOW : <<extend>>

UC_ALERT -down- DE 

UC_ALERT_SEARCH .up.> UC_ALERT_LIST : <<extend>>
UC_ALERT_DETAIL .up.> UC_ALERT_LIST : <<extend>>

UC_NET -[hidden]down- UC_ALERT

UC_ALERT_STATUS .down.> UC_ALERT_DETAIL : <<extend>>

UC_EXPORT_REPORT .up.> UC_VIEW_REPORTS : <<extend>>
UC_GEN_REPORT .up.> UC_VIEW_REPORTS : <<extend>>

UC_EXPORT_REPORT .[hidden]left.> UC_GEN_REPORT 


' ─── Relationships ────────────────────────────────────
'UC_EXPORT_REPORT .right.> UC_VIEW_DASH : <<extend>>
'UC_AUTH .down.> UC_VIEW_DASH : <<include>>

'UC_EXPORT_REPORT .up.> UC_VIEW_DASH : <<extend>>
'UC_EXPORT_REPORT .right.> UC_VIEW_DASH : <<extend>>

'UC_ALERT_STATUS .up.> UC_ALERT_LIST : <<extend>>
@enduml